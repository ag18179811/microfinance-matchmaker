GROQ_API_KEY=
PORT=3001

# Postgres connection string from Supabase (Project Settings -> Database -> Connection string)
DATABASE_URL=

# From Supabase Project Settings -> API. The service role key is a full
# database bypass credential — keep it server-side only, never in the client.
VITE_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of frontend origins allowed to call this API
# (your Vercel URL(s) + http://localhost:5173 for local dev)
ALLOWED_ORIGINS=http://localhost:5173
